#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_PORT="${API_PORT:-3001}"
WEB_PORT="${WEB_PORT:-5173}"

api_pid=""
web_pid=""

cleanup() {
  trap - INT TERM EXIT
  [ -n "$api_pid" ] && kill "$api_pid" 2>/dev/null || true
  [ -n "$web_pid" ] && kill "$web_pid" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup INT TERM EXIT

# lsof exits non-zero when nothing is listening, which under `set -o pipefail`
# would abort the script instead of reporting a free port.
port_owner() {
  { lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null || true; } | awk 'NR==2 {print $1" (pid "$2")"}'
}

for spec in "API:$API_PORT" "web:$WEB_PORT"; do
  name="${spec%%:*}"; port="${spec##*:}"
  owner="$(port_owner "$port")"
  if [ -n "$owner" ]; then
    echo "error: $name port $port is already in use by $owner" >&2
    var="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')_PORT"
    echo "       stop it, or re-run with $var=<other port>" >&2
    exit 1
  fi
done

echo "==> API  http://127.0.0.1:$API_PORT"
echo "==> web  http://127.0.0.1:$WEB_PORT"

( cd "$root/api" && exec rbenv exec bundle exec rails server -p "$API_PORT" -b 127.0.0.1 ) &
api_pid=$!

# Fail loudly and immediately if the API cannot come up, instead of leaving the
# frontend running against a port that nothing is serving.
for _ in $(seq 1 60); do
  if ! kill -0 "$api_pid" 2>/dev/null; then
    echo "error: the API exited during startup (see the output above)" >&2
    exit 1
  fi
  if curl -fsS -m 2 "http://127.0.0.1:$API_PORT/up" >/dev/null 2>&1; then
    echo "==> API is up"
    break
  fi
  sleep 1
done

if ! curl -fsS -m 2 "http://127.0.0.1:$API_PORT/up" >/dev/null 2>&1; then
  echo "error: the API did not answer /up on port $API_PORT within 60s" >&2
  exit 1
fi

( cd "$root/web" && exec env VITE_API_PORT="$API_PORT" npm run dev -- --host 127.0.0.1 --port "$WEB_PORT" --strictPort ) &
web_pid=$!

# Exit as soon as EITHER process dies, so a dead API is never silent.
while kill -0 "$api_pid" 2>/dev/null && kill -0 "$web_pid" 2>/dev/null; do
  sleep 1
done

if ! kill -0 "$api_pid" 2>/dev/null; then
  echo "error: the API process exited; shutting down" >&2
else
  echo "error: the web process exited; shutting down" >&2
fi
exit 1
